{% if include_css %}<link rel="stylesheet" href="{{ css_href }}">{% endif %}
<div class="mgmtd-ui" data-mode="{{ mode }}">
  {% if include_mode_switch %}
  <div class="mgmtd-toolbar">{{ mode_switch_html|safe }}</div>
  {% endif %}
  <div class="mgmtd-body">
    <nav class="mgmtd-tree" aria-label="{{ tree_label }}">
      {% if empty_schema %}
      <p class="muted">{{ empty_tree }}</p>
      {% else %}
      {{ tree_html|safe }}
      {% endif %}
    </nav>
    <section class="mgmtd-pane">
      {{ pane_html|safe }}
    </section>
  </div>
</div>
