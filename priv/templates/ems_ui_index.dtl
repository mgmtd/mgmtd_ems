<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>mgmtd EMS</title>
  <link rel="stylesheet" href="{{ css_href }}">
</head>
<body class="mgmtd-ui-page">
  <div class="mgmtd-shell">
    <header class="mgmtd-chrome">
      <div>
        <h1>mgmtd EMS</h1>
        <p>RESTCONF nodes</p>
      </div>
      <div class="mgmtd-chrome-end">
        {% if can_write %}
        <button type="button" class="btn" onclick="document.getElementById('add-node').showModal()">Add node</button>
        {% endif %}
        {% include "ems_ui_account.dtl" %}
      </div>
    </header>
    {% if error %}<p class="banner-error">{{ error }}</p>{% endif %}
    {% if empty %}
    <p class="empty-hint">{% if can_write %}No nodes yet. Use Add to register a RESTCONF host.{% else %}No nodes yet.{% endif %}</p>
    {% else %}
    <table class="inv-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Address</th>
          <th>Status</th>
          <th>Schema</th>
          {% if can_write %}<th></th>{% endif %}
        </tr>
      </thead>
      <tbody>
        {% for n in nodes %}
        <tr>
          <td><a href="{{ n.href }}">{{ n.name }}</a></td>
          <td class="muted">{{ n.address }}</td>
          <td><span class="inv-status is-{{ n.status }}">{{ n.status }}</span></td>
          <td class="muted">{{ n.schema }}</td>
          {% if can_write %}
          <td>
            <form method="post" action="{{ n.remove_href }}" class="inv-remove">
              <button class="btn-danger" type="submit">Remove</button>
            </form>
          </td>
          {% endif %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
    {% if can_write %}
    <dialog id="add-node" class="add-dialog" aria-labelledby="add-node-title">
      <form class="inv-add" method="post" action="/nodes">
        <h3 id="add-node-title">Add node</h3>
        {% if error %}<p class="banner-error">{{ error }}</p>{% endif %}
        <label class="draft-label">Name <input class="field" name="name" required autofocus></label>
        <label class="draft-label">Host <input class="field" name="host" required></label>
        <label class="draft-label">Port <input class="field" type="number" name="port" value="8008"></label>
        <label class="draft-label inv-check"><input type="checkbox" name="tls" value="true"> TLS</label>
        <label class="draft-label">User <input class="field" name="user"></label>
        <label class="draft-label">Password <input class="field" type="password" name="password"></label>
        <div class="dialog-actions">
          <button type="button" class="btn-quiet" onclick="this.closest('dialog').close()">Cancel</button>
          <button class="btn" type="submit">Add</button>
        </div>
      </form>
    </dialog>
    <script>
      (function () {
        var d = document.getElementById("add-node");
        if (!d) return;
        d.addEventListener("click", function (e) { if (e.target === d) d.close(); });
        {% if error %}d.showModal();{% endif %}
      })();
    </script>
    {% endif %}
  </div>
</body>
</html>
