<nav class="mode-switch" aria-label="Data view">
  <a class="mode-opt{% if mode_config %} is-active{% endif %}"
     href="{{ config_href }}"
     title="Configuration"{% if mode_config %} aria-current="page"{% endif %}>Config</a>
  <a class="mode-opt{% if mode_oper %} is-active{% endif %}"
     href="{{ oper_href }}"
     title="Operational state"{% if mode_oper %} aria-current="page"{% endif %}>Operational</a>
  {% if show_actions %}
  <a class="mode-opt{% if mode_actions %} is-active{% endif %}"
     href="{{ actions_href }}"
     title="RPC actions"{% if mode_actions %} aria-current="page"{% endif %}>Actions</a>
  {% endif %}
</nav>
