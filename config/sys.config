%% Runtime config for `rebar3 shell`. Web UI at http://127.0.0.1:8081/
%% (form login). Passwords are plaintext; change them.
[
  {mgmtd_ems, [
    {db_dir, "db"},
    {http, [
      {enabled, true},
      {port, 8081},
      {auth, [
        {users, [
          {"alice", "secret"},
          {"bob", "guest", read_only}
        ]}
      ]}
    ]},
    {cli, [
      {enabled, true},
      {socket, "/var/tmp/mgmtd_ems.cli.socket"}
    ]}
  ]}
].
